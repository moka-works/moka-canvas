{
  "displayName": "Alibaba Cloud · Bailian Video",
  "labels": { "zh": "阿里云百炼 · 视频生成" },
  "urlExample": "https://{workspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis",
  "script": "bailian-video.lua",
  "order": 30,
  "auth": { "header": "Authorization", "scheme": "Bearer" },
  "promptRewrite": {
    "guide": "prompt-guide.md",
    "checks": { "negativeBait": true },
    "version": 1
  },
  "parameters": [
    {
      "key": "prompt_extend",
      "type": "boolean",
      "label": {
        "en": "Prompt extension",
        "zh": "提示词智能改写"
      },
      "hint": {
        "en": "Let Wan rewrite the prompt before filming. Turn it off to send the words as they are.",
        "zh": "让万相在生成前自动改写提示词；关闭后按原样发送。"
      },
      "default": true
    }
  ],
  "version": 6
}
